# Copy to .env and fill in. Never commit .env.
# Every value here must ALSO be added in cloud.trigger.dev → this project → Environment Variables
# (staging and prod). A production deploy uploads .env automatically (see trigger.config.ts).

# --- Trigger.dev ---
# cloud.trigger.dev → THIS project → API Keys → Development secret key (tr_dev_...). Local only, never uploaded.
TRIGGER_SECRET_KEY=

# --- HubSpot (free CRM) ---
# Development → Keys → Service keys → your "Lead Qualifier" key → copy the key.
# (Older accounts: Settings → Integrations → Private Apps → Show token, pat-...)
HUBSPOT_ACCESS_TOKEN=
# Owner IDs, printed by the hubspot-setup task. Rep A covers North + West, Rep B covers South + Commercial,
# the Manager gets every Needs Review task. With one HubSpot user, put the same ID in all three.
HUBSPOT_OWNER_REP_A=
HUBSPOT_OWNER_REP_B=
HUBSPOT_OWNER_MANAGER=
# Deal pipeline and stage IDs, printed by the hubspot-setup task (free accounts: "Sales Pipeline" is usually "default").
HUBSPOT_PIPELINE_ID=default
# Stage new qualified deals start in ("Qualified to buy" is usually "qualifiedtobuy").
HUBSPOT_STAGE_QUALIFIED=qualifiedtobuy
# Stage the rep moves a deal to when the customer books ("Appointment scheduled" is usually "appointmentscheduled").
HUBSPOT_STAGE_BOOKED=appointmentscheduled

# --- Anthropic / Claude (writes the explanation and email drafts, never the score) ---
# platform.claude.com → Settings → API Keys (sk-ant-...)
ANTHROPIC_API_KEY=
# Optional. Default claude-haiku-5-5 (well under 1 cent per lead).
LEAD_MODEL=claude-haiku-5-5

# --- Gmail (follow-up drafts and alert emails) ---
# The Gmail account whose Drafts folder gets the follow-ups.
LEAD_GMAIL_USER=
# myaccount.google.com/apppasswords (needs 2-Step Verification). 16 characters.
LEAD_GMAIL_APP_PASSWORD=
# Where safety alerts, failed runs and the weekly metrics email go.
ALERT_EMAIL_TO=

# --- Business ---
COMPANY_NAME=Summit Air HVAC
# Optional. Cal.com (or any) booking link added to Hot lead drafts. Empty = a "reply to book" line instead.
BOOKING_URL=

# --- Lead inbox (emailed leads) ---
# Address customers and website form notifications send leads to. Empty = your LEAD_GMAIL_USER with +leads
# (e.g. you+leads@gmail.com): it lands in the same inbox, and only mail sent to it is read as a lead.
LEAD_INBOX_ADDRESS=
